# Primo MCP Server Configuration (PittCat build)
#
# This build ships with University of Pittsburgh / PittCat defaults, so it runs
# with NO configuration. Every variable below is optional; set one only to
# override the built-in default (for example, to point the server at a
# different Primo view). See the README for how to read the values off a
# discovery URL.

# Institution-specific defaults (already baked in; shown here for reference).
# PRIMO_BASE_URL=https://pitt.primo.exlibrisgroup.com/primaws/rest/pub
# PRIMO_VID=01PITT_INST:01PITT_INST
# PRIMO_INSTITUTION_CODE=            # derived from the VID prefix when unset
# PRIMO_INSTITUTION_NAME=University of Pittsburgh
# PRIMO_DISCOVERY_NAME=PittCat
# PRIMO_TAB_EVERYTHING=Everything
# PRIMO_TAB_CATALOGUE=LibraryCatalog
# PRIMO_SCOPE_COMBINED=MyInst_and_CI
# PRIMO_SCOPE_LOCAL=MyInstitution

# Optional search behaviour.
# Default for the include_unavailable search argument. true = Primo's
# "expanded" search, including records the institution has no full-text access
# to; false = restrict results to currently-available material.
# PRIMO_INCLUDE_UNAVAILABLE=true

# Optional operational tuning.
# PRIMO_REQUEST_TIMEOUT=30.0
# PRIMO_MAX_RESULTS_PER_REQUEST=50
# PRIMO_DEFAULT_RESULTS=10
# PRIMO_LANGUAGE=en
# PRIMO_USER_AGENT=primo-mcp-server/0.1.0
