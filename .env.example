# Primo MCP Server Configuration
# All values have UWA defaults -- only override if connecting to a different institution.

# PRIMO_BASE_URL=https://onesearch.library.uwa.edu.au/primaws/rest/pub
# PRIMO_VID=61UWA_INST:NDE_UWA
# Institution code for the guest-token endpoint used by single-record lookup.
# Leave unset to derive it from the VID prefix (correct for standard Primo VE
# view IDs); set it only if your guest-token endpoint uses a different code.
# PRIMO_INSTITUTION_CODE=
# PRIMO_INSTITUTION_NAME=UWA
# PRIMO_TAB_EVERYTHING=Everything
# PRIMO_TAB_CATALOGUE=Catalogue
# PRIMO_SCOPE_COMBINED=MyInst_and_CI
# PRIMO_SCOPE_LOCAL=MyInstitution
# PRIMO_REQUEST_TIMEOUT=30.0
# PRIMO_MAX_RESULTS_PER_REQUEST=50
# PRIMO_DEFAULT_RESULTS=10
# PRIMO_LANGUAGE=en
