# Primo MCP Server Configuration
#
# PRIMO_BASE_URL and PRIMO_VID are REQUIRED. Set them to your institution's
# Primo VE values; the server refuses to start without them. See the
# "Finding your Primo settings" section of the README for how to read them off
# your discovery URL. Everything below is optional and falls back to the
# defaults shown.

# Required. Your Primo VE public API base (ends in /primaws/rest/pub) and your
# view ID (<inst_code>:<view_code>). Examples:
#   PRIMO_BASE_URL=https://YOUR-INST.primo.exlibrisgroup.com/primaws/rest/pub
#   PRIMO_VID=01YOUR_INST:YOUR_VIEW
PRIMO_BASE_URL=
PRIMO_VID=

# Optional. Institution code for the guest-token endpoint; derived from the VID
# prefix when unset, which is correct for standard Primo VE view IDs.
# PRIMO_INSTITUTION_CODE=

# Optional display / branding.
# PRIMO_INSTITUTION_NAME=the library catalogue
# PRIMO_DISCOVERY_NAME=            # brand shown in "Check availability in ..."; defaults to INSTITUTION_NAME

# Optional. Tab and scope names -- override if your Primo view differs from the
# common values shown.
# PRIMO_TAB_EVERYTHING=Everything
# PRIMO_TAB_CATALOGUE=Catalogue
# PRIMO_SCOPE_COMBINED=MyInst_and_CI
# PRIMO_SCOPE_LOCAL=MyInstitution

# Optional operational tuning.
# PRIMO_REQUEST_TIMEOUT=30.0
# PRIMO_MAX_RESULTS_PER_REQUEST=50
# PRIMO_DEFAULT_RESULTS=10
# PRIMO_LANGUAGE=en
# PRIMO_USER_AGENT=primo-mcp-server/0.1.0
